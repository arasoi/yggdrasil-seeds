<?xml version="1.0"?>
<ServerSettings>
  <property name="ServerPort" value="{{.Ports.game}}"/>
  <property name="ServerVisibility" value="{{.Vars.server_visibility}}"/>
  <property name="ServerName" value="{{.Vars.server_name}}"/>
  <property name="ServerPassword" value="{{.Vars.server_password}}"/>
  <property name="ServerMaxPlayerCount" value="{{.Vars.max_players}}"/>
  <property name="ServerReservedSlots" value="0"/>
  <property name="ServerReservedSlotsPermission" value="100"/>
  <property name="ServerAdminSlots" value="0"/>
  <property name="ServerAdminSlotsPermission" value="0"/>

  <property name="ServerDescription" value="{{.Vars.server_description}}"/>
  <property name="ServerWebsiteURL" value=""/>
  <!-- A dedicated server with correctly forwarded ports doesn't need Steam's
       own P2P relay layer; the reference config this is built from
       disables it for exactly that reason. -->
  <property name="ServerDisabledNetworkProtocols" value="SteamNetworking"/>

  <property name="GameWorld" value="{{.Vars.game_world}}"/>
  <property name="WorldGenSeed" value="{{.Vars.world_gen_seed}}"/>
  <property name="WorldGenSize" value="{{.Vars.world_gen_size}}"/>
  <property name="GameName" value="{{.Vars.game_name}}"/>
  <property name="GameDifficulty" value="{{.Vars.game_difficulty}}"/>
  <property name="GameMode" value="GameModeSurvival"/>

  <property name="ZombieMove" value="{{.Vars.zombie_move}}"/>
  <property name="ZombieMoveNight" value="{{.Vars.zombie_move_night}}"/>
  <property name="ZombieFeralMove" value="{{.Vars.zombie_feral_move}}"/>
  <property name="ZombieBMMove" value="{{.Vars.zombie_bm_move}}"/>
  <property name="BuildCreate" value="false"/>
  <property name="DayNightLength" value="{{.Vars.day_night_length}}"/>
  <property name="DayLightLength" value="{{.Vars.day_light_length}}"/>
  <property name="PlayerKillingMode" value="{{.Vars.player_killing_mode}}"/>
  <property name="PersistentPlayerProfiles" value="false"/>

  <property name="PlayerSafeZoneLevel" value="5"/>
  <property name="PlayerSafeZoneHours" value="5"/>

  <!-- The web control panel (ControlPanelEnabled/Port/Password) is not a
       recognized configfile property against the current dedicated server
       build; it aborts startup with "Unknown config option" the instant it
       is present, present or not, true or false. Confirmed live against a
       real fresh SteamCMD depot, and matches other operators hitting the
       same abort on current builds (GameServerManagers/LinuxGSM#4291). The
       feature is gone from this build, not merely renamed, so there is no
       replacement property to put here; Telnet remains the one remote
       admin interface this seed exposes, below. -->

  <property name="TelnetEnabled" value="{{.Vars.telnet_enabled}}"/>
  <property name="TelnetPort" value="{{.Ports.telnet}}"/>
  <property name="TelnetPassword" value="{{.Vars.telnet_password}}"/>
  <property name="TelnetFailedLoginLimit" value="10"/>
  <property name="TelnetFailedLoginsBlocktime" value="10"/>

  <!-- Windows-only console window; meaningless under -nographics on Linux. -->
  <property name="TerminalWindowEnabled" value="false"/>

  <property name="AdminFileName" value="serveradmin.xml"/>

  <property name="DropOnDeath" value="{{.Vars.drop_on_death}}"/>
  <property name="DropOnQuit" value="{{.Vars.drop_on_quit}}"/>

  <property name="BloodMoonEnemyCount" value="{{.Vars.blood_moon_enemy_count}}"/>
  <property name="EnemySpawnMode" value="{{.Vars.enemy_spawn_mode}}"/>
  <property name="EnemyDifficulty" value="{{.Vars.enemy_difficulty}}"/>

  <property name="BlockDurabilityModifier" value="100"/>

  <property name="LootAbundance" value="{{.Vars.loot_abundance}}"/>
  <property name="LootRespawnDays" value="{{.Vars.loot_respawn_days}}"/>

  <property name="LandClaimSize" value="41"/>
  <property name="LandClaimDeadZone" value="30"/>
  <property name="LandClaimExpiryTime" value="{{.Vars.land_claim_expiry_time}}"/>
  <property name="LandClaimDecayMode" value="0"/>
  <property name="LandClaimOnlineDurabilityModifier" value="4"/>
  <property name="LandClaimOfflineDurabilityModifier" value="4"/>

  <property name="PartySharedKillRange" value="100"/>
  <property name="AirDropFrequency" value="{{.Vars.air_drop_frequency}}"/>
  <property name="AirDropMarker" value="false"/>
  <property name="MaxSpawnedZombies" value="{{.Vars.max_spawned_zombies}}"/>
  <property name="MaxSpawnedAnimals" value="{{.Vars.max_spawned_animals}}"/>

  <property name="EACEnabled" value="{{.Vars.eac_enabled}}"/>
  <property name="HideCommandExecutionLog" value="0"/>
  <property name="MaxUncoveredMapChunksPerPlayer" value="131072"/>
  <property name="BedrollDeadZoneSize" value="15"/>

  <!-- Redirects saves (and, per the game's own AdminFileName documentation,
       serveradmin.xml alongside them) into this server's writable mount
       rather than Unity's default ~/.local/share/7DaysToDie; see the seed
       comment above the writable_paths block for why this one is hardcoded
       rather than exposed as a variable. -->
  <property name="SaveGameFolder" value="/data/Saves"/>

  <property name="ServerLoginConfirmationText" value=""/>
</ServerSettings>
