#!/bin/sh
# Written by the seed on every rebuild; edits here are replaced.
#
# Squad reads ServerConfig/ and writes Saved/ in its project directory, which
# Unreal finds from the executable's real path -- inside the read-only
# install. So the server runs from a copy of the layout under HOME: the
# executable itself is a real file (220 MB, copied again only when it
# changes), Content, Plugins and the engine are symlinks into the install,
# and ServerConfig is this server's own directory. Verified on inari.
S=$HOME/server
G=$S/SquadGame
B=$G/Binaries/Linux
mkdir -p "$B" "$S/Engine" "$G/ServerConfig" "$G/Saved"
for f in /game/Engine/*; do
  [ -e "$S/Engine/${f##*/}" ] || ln -s "$f" "$S/Engine/${f##*/}"
done
for d in Content Plugins; do ln -sfn "/game/SquadGame/$d" "$G/$d"; done
for f in /game/SquadGame/Binaries/Linux/*; do
  n=${f##*/}
  [ "$n" = SquadGameServer ] || ln -sfn "$f" "$B/$n"
done
cp -u /game/SquadGame/Binaries/Linux/SquadGameServer "$B/SquadGameServer"

# Fill in every config file the server has not got yet from the shipped ones.
C=$G/ServerConfig
D=/game/SquadGame/ServerConfig
for f in "$D"/*; do
  n=${f##*/}
  [ -e "$C/$n" ] || cp "$f" "$C/$n"
done

# The first rebuild writes Server.cfg with only the keys the seed manages, so
# once, rebuild it from the default file with those values in place: every
# other default key and comment is kept, and a later rebuild patches the full
# file.
if [ ! -e "$C/.ygg-merged" ]; then
  awk '
    function key(line) {
      if (line ~ /^[ \t]*\/\// || index(line, "=") == 0) return ""
      return substr(line, 1, index(line, "=") - 1)
    }
    NR == FNR { k = key($0); if (k != "") { v[k] = $0; order[++n] = k } next }
    { k = key($0); if (k != "" && (k in v)) { print v[k]; seen[k] = 1; next } print }
    END { for (i = 1; i <= n; i++) if (!(order[i] in seen)) print v[order[i]] }
  ' "$C/Server.cfg" "$D/Server.cfg" > "$C/Server.cfg.tmp" &&
    mv "$C/Server.cfg.tmp" "$C/Server.cfg" && touch "$C/.ygg-merged"
fi

exec stdbuf -oL -eL "$B/SquadGameServer" SquadGame \
  Port={{.Ports.game}} QueryPort={{.Ports.query}} -beaconport={{.Ports.beacon}} \
  RCONPORT={{.Ports.rcon}}{{if .Vars.rcon_password}} RCONPASSWORD={{shellquote .Vars.rcon_password}}{{end}} \
  -log
